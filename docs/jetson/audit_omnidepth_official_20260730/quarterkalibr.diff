@@ -1,7 +1,39 @@
 #!/usr/bin/env python3
 import cv2 as cv
 import numpy as np
-from transformations import *
+
+
+def euler_matrix(ai, aj, ak, axes='sxyz'):
+    """Return a 4x4 static-XYZ Euler rotation matrix.
+
+    quarterKalibr only uses the ``sxyz`` convention, so keeping the
+    implementation local avoids its undeclared dependency on the external
+    ``transformations`` Python package.
+    """
+    if axes != 'sxyz':
+        raise ValueError("Only the static XYZ Euler convention is supported")
+    si, sj, sk = np.sin([ai, aj, ak])
+    ci, cj, ck = np.cos([ai, aj, ak])
+    rotation_x = np.array([
+        [1.0, 0.0, 0.0],
+        [0.0, ci, -si],
+        [0.0, si, ci],
+    ])
+    rotation_y = np.array([
+        [cj, 0.0, sj],
+        [0.0, 1.0, 0.0],
+        [-sj, 0.0, cj],
+    ])
+    rotation_z = np.array([
+        [ck, -sk, 0.0],
+        [sk, ck, 0.0],
+        [0.0, 0.0, 1.0],
+    ])
+    transform = np.eye(4)
+    transform[:3, :3] = rotation_z @ rotation_y @ rotation_x
+    return transform
+
+

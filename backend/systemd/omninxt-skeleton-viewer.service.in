[Unit]
Description=OmniNxt received 3-D skeleton browser viewer
After=omninxt-skeleton-receiver.service
Wants=omninxt-skeleton-receiver.service

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=@REPO_ROOT@/backend/run_skeleton_viewer.sh
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target

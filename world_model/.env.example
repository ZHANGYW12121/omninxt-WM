# Optional machine-local paths. Copy to .env.local and source it before tools
# that consume Isaac records. Never commit .env.local.
OMNINXT_WORKSPACE_ROOT=/path/to/workspace
ISAAC_APP_DIR=/path/to/isaacsim/database
R2DREAMER_DATA_ROOT=/data/omninxt/isaac_records
R2DREAMER_OUTPUT_ROOT=/data/omninxt/r2dreamer_runs

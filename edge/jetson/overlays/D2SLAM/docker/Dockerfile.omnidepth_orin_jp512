FROM omninxt/jetson-orin-base:opencv-ccalib-r35.4.1

ARG USE_PROC=2

ENV USE_PROC=${USE_PROC}
ENV OpenCV_DIR=/usr/local/lib/cmake/opencv4
ENV CMAKE_PREFIX_PATH=/usr/local:/opt/ros/noetic
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/lib

# D2SLAM's official Jetson Dockerfile pins LCM v1.4.0.  Ubuntu Focal's
# liblcm-dev 1.3.1 has an incompatible C++ hash-chain structure for the
# generated swarm_msgs headers.
COPY deps/lcm /opt/src/lcm

RUN cmake -S /opt/src/lcm -B /opt/src/lcm/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_TESTING=OFF \
      -DLCM_ENABLE_JAVA=OFF \
      -DLCM_ENABLE_PYTHON=OFF && \
    cmake --build /opt/src/lcm/build --parallel ${USE_PROC} && \
    cmake --install /opt/src/lcm/build && \
    ldconfig && \
    rm -rf /opt/src/lcm

RUN printf '%s\n' \
      'source /opt/ros/noetic/setup.bash' \
      'export OpenCV_DIR=/usr/local/lib/cmake/opencv4' \
      'export CMAKE_PREFIX_PATH=/usr/local:/opt/ros/noetic:${CMAKE_PREFIX_PATH:-}' \
      'export PATH=/usr/local/cuda/bin:${PATH}' \
      'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/lib:${LD_LIBRARY_PATH:-}' \
      > /etc/profile.d/omninxt-jp512.sh

CMD ["bash"]

+# FORMALLY_CALIBRATED_2026-07-30
+# OAK-FFC-4P MXID 19443010E16C6A2E00.
+# Physical order: CAM_A front-right, CAM_B rear-right,
+# CAM_C rear-left, CAM_D front-left.
+# AprilGrid: 6x6, nominal tagSize 0.088 m, tagSpacing 0.3.
+# Virtual stereo: fov 190 deg, 320x240, direct pair calibration.
+enable_cnn: true
+cnn_int8: false
+cnn_fp16: true
+cnn_use_tensorrt: true
+cnn_type: "hitnet"
+# The simulator chain consumes disparity derived from synchronized Isaac
+# distance_to_camera. Set this back to "hitnet" for the real camera chain.
+depth_source: "isaac_gt"
+gt_disparity_topic: "/omninxt_gt/disparity_mosaic"
+# cnn_type: "crestereo"
+onnx_path: "/root/swarm_ws/src/D2SLAM/models/hitnet_series/hitnet_1x240x320_model_float16_quant_opt.onnx"
+cnn_quant_path: ""
+trt_engine_path: "/root/swarm_ws/src/D2SLAM/models/hitnet_series/hitnet_1x240x320_model_float16_quant_opt_sync_20260802_sm89.trt"
+cnn_input_rgb : false
+# The four HITNet contexts already saturate the Nano GPU. Keep geometric
+# remapping on the CPU so it can overlap with inference.
+use_cuda_rectification: false
+enable_texture: false
+width: 320
+height: 240
+pixel_step: 2
+image_step: 3
+max_z: 10
+min_z: 0.1

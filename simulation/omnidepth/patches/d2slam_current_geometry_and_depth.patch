+int32_t VirtualStereo::rectifyImageCpu(const cv::Mat & left,
+                                       const cv::Mat & right,
+                                       cv::Mat & rect_left,
+                                       cv::Mat & rect_right) {
+    cv::Mat undistorted_left;
+    cv::Mat undistorted_right;
+    if (input_is_stereo) {
+        undistorted_left = left;
+        undistorted_right = right;
+    } else {
+        cv::remap(left, undistorted_left,
+                  undist_left->undistMaps[undist_id_l].first,
+                  undist_left->undistMaps[undist_id_l].second,
+                  cv::INTER_LINEAR);
+        cv::remap(right, undistorted_right,
+                  undist_right->undistMaps[undist_id_r].first,
+                  undist_right->undistMaps[undist_id_r].second,
+                  cv::INTER_LINEAR);
+        if (undist_left->photometics.size() >
+            static_cast<std::size_t>(undist_id_l)) {
+            cv::Mat work;
+            undistorted_left.convertTo(work, CV_32F);
+            cv::multiply(work, undist_left->photometics[undist_id_l], work);
+            work.convertTo(undistorted_left, CV_8U);
+        }
+        if (undist_right->photometics.size() >
+            static_cast<std::size_t>(undist_id_r)) {
+            cv::Mat work;
+            undistorted_right.convertTo(work, CV_32F);
+            cv::multiply(work, undist_right->photometics[undist_id_r], work);
+            work.convertTo(undistorted_right, CV_8U);
+        }
+    }
+    cv::remap(undistorted_left, rect_left, lmap_1, lmap_2,
+              cv::INTER_LINEAR);
+    cv::remap(undistorted_right, rect_right, rmap_1, rmap_2,
+              cv::INTER_LINEAR);
+    return 0;
+}
